# ── Upstream ACP agent ──────────────────────────────────────────────────────
# Base URL of the agent's ACP server. The gateway calls {ACP_URL}/acp.
# e.g. goose:  `goose serve --host 0.0.0.0 --port 3000`
ACP_URL=http://localhost:3000
# Working directory passed to the agent's session/new.
ACP_CWD=/workspace
# Session mode (goose: auto | smart_approve | approve | chat). `auto` keeps tools
# enabled and never stalls a headless turn on a permission prompt.
ACP_MODE=auto

# ── HTTP server ─────────────────────────────────────────────────────────────
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8000
# If set, clients must send `Authorization: Bearer <key>`. Empty = open (local).
GATEWAY_API_KEY=

# ── Model surface ───────────────────────────────────────────────────────────
# Model id advertised on /v1/models. Empty = derive from the agent's own
# name/version reported during the ACP `initialize` handshake.
MODEL_ID=

# ── Streaming detail ────────────────────────────────────────────────────────
# Stream the agent's reasoning wrapped in <think></think> (some UIs render it as
# collapsible; raw OpenAI clients show the literal tags).
EMIT_THOUGHTS=false
# Emit a short status line for each tool call.
EMIT_TOOL_STATUS=false

# ── Conversation continuity ─────────────────────────────────────────────────
# Map (stateless) OpenAI chats to (stateful) ACP sessions; persisted here so the
# mapping survives restarts. Empty = in-memory only.
SESSION_STATE_PATH=.acp_sessions.json
# Seed a new session with the full transcript when a conversation can't be
# matched to a known session (restart, edited/branched history).
COLD_SEED_HISTORY=true

# ── Timeouts (seconds) ──────────────────────────────────────────────────────
CONNECT_TIMEOUT=10
READ_TIMEOUT=1800
